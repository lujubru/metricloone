// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  socialProfiles SocialProfile[]
  posts         Post[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Custom models for Metricool clone

model SocialProfile {
  id            String   @id @default(cuid())
  userId        String
  platform      String   // e.g., 'facebook', 'instagram', 'twitter', 'linkedin'
  profileId     String   // The ID on the platform
  username      String?
  accessToken   String   @db.Text
  refreshToken  String?  @db.Text
  tokenExpiresAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts         Post[]

  @@unique([platform, profileId])
}

model Post {
  id              String   @id @default(cuid())
  userId          String
  socialProfileId String
  content         String   @db.Text
  mediaUrls       String[] // Array of media URLs
  scheduledFor    DateTime
  status          String   @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, FAILED
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialProfile   SocialProfile @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)
}
