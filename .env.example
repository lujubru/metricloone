# PostgreSQL (Railway, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/database"

# NextAuth: URL pública de la app y secreto de firma del JWT
NEXTAUTH_URL="https://metricool.pixeldesarrollo.com"
NEXTAUTH_SECRET="generá-uno-con-openssl-rand-base64-32"

# Clave para cifrar los App Secret de Facebook de cada cuenta (AES-256-GCM).
# Si se cambia, hay que volver a cargar las credenciales en /admin.
APP_ENCRYPTION_KEY="otra-cadena-larga-y-aleatoria"

# Primer usuario administrador (sólo lo usa `npm run db:bootstrap`)
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="una-clave-de-al-menos-8-caracteres"
ADMIN_NAME="Administrador"

# Scheduler de publicación automática (poner false para desactivarlo)
SCHEDULER_ENABLED="true"

# Protección opcional del endpoint /api/cron/publish
# CRON_SECRET="cadena-larga"
